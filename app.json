{
  "expo": {
    "name": "StudoCore",
    "slug": "StudoCore-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "studocore",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram"
        ]
      },
      "bundleIdentifier": "com.studocore.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.studocore.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O StudoCore usa a câmera para você registrar uma foto do seu momento de estudo ao fim da sessão.",
          "photosPermission": "O StudoCore acessa suas fotos para você escolher a imagem da sessão ou seu avatar."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "O StudoCore usa seus contatos para você convidar amigos para estudar junto."
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram"
          ],
          "android": [
            "com.instagram.android"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62969bad-a493-43dd-b2bc-5689ed99fa5c"
      }
    }
  }
}
